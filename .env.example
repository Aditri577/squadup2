# SquadUP — Environment Variables
# Copy this file to .env and fill in your real values

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# REQUIRED: Use a long random string. Generate with: openssl rand -base64 64
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-64-chars

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── App Config ───────────────────────────────────────────────────────────────
# Set DEMO_MODE=true to allow a demo user switcher in the header
DEMO_MODE=false

# JWT token expiry (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# ─── MySQL (Optional) ─────────────────────────────────────────────────────────
# If not set, app falls back to local db.json file
# For production: use PlanetScale, Railway MySQL, or Supabase
# DB_HOST=your-mysql-host
# DB_USER=your-mysql-user
# DB_PASSWORD=your-mysql-password
# DB_NAME=squadup
# DB_PORT=3306

# ─── Deployment ───────────────────────────────────────────────────────────────
# For production deployment on Railway/Render
# NODE_ENV=production
# PORT=3000
